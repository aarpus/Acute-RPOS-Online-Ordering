@baseUrl = https://your-domain.example
@storeCode = YOUR_STORE_CODE
@token = YOUR_POS_TOKEN

### Insert a group; no items or options need to exist yet
POST {{baseUrl}}/api/pos/stores/{{storeCode}}/modifier-groups/sync
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "request_id": "modifier-groups-20261105-001",
  "modifier_groups": [
    {
      "external_group_id": "GRP-ADDONS",
      "name": "Extra Add-ons",
      "selection_type": "multiple",
      "min_select": 0,
      "max_select": 3,
      "allow_option_quantity": true,
      "display_order": 1,
      "is_active": true
    }
  ]
}

### Update the same group; omitted optional fields retain their values
POST {{baseUrl}}/api/pos/stores/{{storeCode}}/modifier-groups/sync
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "request_id": "modifier-groups-20261105-002",
  "modifier_groups": [
    {
      "external_group_id": "GRP-ADDONS",
      "name": "Extra Add-ons",
      "max_select": 4
    }
  ]
}
