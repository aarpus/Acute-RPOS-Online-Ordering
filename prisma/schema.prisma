generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderType {
  pickup
  delivery
}

enum OrderStatus {
  placed
  accepted
  preparing
  ready
  out_for_delivery
  completed
  cancelled
}

enum OrderTiming {
  asap
  scheduled
}

enum OrderPaymentStatus {
  pending
  paid
}

enum OrderOptionType {
  variant
  modifier
  combo
}

enum OrderPaymentMethod {
  cash_on_delivery
  pay_at_pickup
}

enum OrderTransactionStatus {
  pending
  success
  failed
  cancelled
}

enum OrderActorType {
  customer
  admin
  system
}

enum OrderOtpPurpose {
  pickup_handover
  delivery_handover
}

enum OrderOtpStatus {
  active
  verified
  expired
  revoked
}

model Order {
  id                   String             @id @default(uuid()) @db.Uuid
  storeCode            String             @map("store_code") @db.VarChar(50)
  orderNumber          String             @map("order_number") @db.VarChar(50)
  userId               String             @map("user_id") @db.Uuid
  orderType            OrderType          @map("order_type")
  status               OrderStatus        @default(placed)
  customerName         String             @map("customer_name") @db.VarChar(150)
  customerPhone        String             @map("customer_phone") @db.VarChar(25)
  customerEmail        String             @map("customer_email") @db.VarChar(255)
  deliveryAddress      Json?              @map("delivery_address") @db.JsonB
  deliveryInstructions String?            @map("delivery_instructions") @db.Text
  timing               OrderTiming        @default(asap)
  scheduledAt          DateTime?          @map("scheduled_at") @db.Timestamptz(6)
  currency             String             @db.VarChar(3)
  subtotal             Decimal            @db.Decimal(12, 2)
  discountAmount       Decimal            @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount            Decimal            @default(0) @map("tax_amount") @db.Decimal(12, 2)
  deliveryFee          Decimal            @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  grandTotal           Decimal            @map("grand_total") @db.Decimal(12, 2)
  paymentStatus        OrderPaymentStatus @default(pending) @map("payment_status")
  customerNotes        String?            @map("customer_notes") @db.Text
  idempotencyKey       String             @map("idempotency_key") @db.VarChar(100)
  checkoutRequestHash  String?            @map("checkout_request_hash") @db.VarChar(64)
  storeSnapshot        Json?              @map("store_snapshot") @db.JsonB
  confirmationSentAt   DateTime?          @map("confirmation_sent_at") @db.Timestamptz(6)
  confirmationAttemptAt DateTime?         @map("confirmation_attempt_at") @db.Timestamptz(6)
  completedAt          DateTime?          @map("completed_at") @db.Timestamptz(6)
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason   String?            @map("cancellation_reason") @db.Text
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User               @relation(fields: [storeCode, userId], references: [storeCode, id], onDelete: Restrict, onUpdate: Restrict)
  items                OrderItem[]
  transactions         OrderTransaction[]
  statusHistory        OrderStatusHistory[]
  otps                 OrderOtp[]

  @@unique([storeCode, id])
  @@unique([storeCode, orderNumber])
  @@unique([storeCode, idempotencyKey])
  @@index([storeCode, status, createdAt])
  @@index([storeCode, userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id                  String            @id @default(uuid()) @db.Uuid
  storeCode           String            @map("store_code") @db.VarChar(50)
  orderId             String            @map("order_id") @db.Uuid
  menuItemId          String            @map("menu_item_id") @db.Uuid
  itemName            String            @map("item_name") @db.VarChar(200)
  itemImageUrl        String?           @map("item_image_url") @db.Text
  inventoryAllocations Json?            @map("inventory_allocations") @db.JsonB
  sku                 String?           @db.VarChar(100)
  quantity            Int
  baseUnitPrice       Decimal           @map("base_unit_price") @db.Decimal(12, 2)
  optionsUnitTotal    Decimal           @default(0) @map("options_unit_total") @db.Decimal(12, 2)
  unitPrice           Decimal           @map("unit_price") @db.Decimal(12, 2)
  subtotal            Decimal           @db.Decimal(12, 2)
  discountAmount      Decimal           @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount           Decimal           @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal           Decimal           @map("line_total") @db.Decimal(12, 2)
  specialInstructions String?           @map("special_instructions") @db.Text
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  order               Order             @relation(fields: [storeCode, orderId], references: [storeCode, id], onDelete: Restrict, onUpdate: Restrict)
  menuItem            MenuItem          @relation(fields: [storeCode, menuItemId], references: [storeCode, id], onDelete: Restrict, onUpdate: Restrict)
  options             OrderItemOption[]

  @@unique([storeCode, id])
  @@index([storeCode, orderId])
  @@index([storeCode, menuItemId])
  @@map("order_items")
}

model OrderItemOption {
  id                  String          @id @default(uuid()) @db.Uuid
  storeCode           String          @map("store_code") @db.VarChar(50)
  orderItemId         String          @map("order_item_id") @db.Uuid
  optionType          OrderOptionType @map("option_type")
  // Polymorphic catalog reference; immutable names/prices preserve the receipt.
  sourceOptionId      String?         @map("source_option_id") @db.Uuid
  selectionKey        String?         @map("selection_key") @db.VarChar(150)
  groupName           String?         @map("group_name") @db.VarChar(150)
  optionName          String          @map("option_name") @db.VarChar(200)
  quantity            Decimal         @default(1) @db.Decimal(12, 3)
  additionalUnitPrice Decimal         @default(0) @map("additional_unit_price") @db.Decimal(12, 2)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  orderItem           OrderItem       @relation(fields: [storeCode, orderItemId], references: [storeCode, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([storeCode, orderItemId])
  @@map("order_item_options")
}

model OrderTransaction {
  id                 String                 @id @default(uuid()) @db.Uuid
  storeCode          String                 @map("store_code") @db.VarChar(50)
  orderId            String                 @map("order_id") @db.Uuid
  paymentMethod      OrderPaymentMethod     @map("payment_method")
  status             OrderTransactionStatus @default(pending)
  amount             Decimal                @db.Decimal(12, 2)
  currency           String                 @db.VarChar(3)
  transactionReference String?              @map("transaction_reference") @db.VarChar(150)
  idempotencyKey     String                 @map("idempotency_key") @db.VarChar(100)
  collectedByAdminId String?                @map("collected_by_admin_id") @db.Uuid
  paidAt             DateTime?              @map("paid_at") @db.Timestamptz(6)
  failureReason      String?                @map("failure_reason") @db.Text
  notes              String?                @db.Text
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  order              Order                  @relation(fields: [storeCode, orderId], references: [storeCode, id], onDelete: Restrict, onUpdate: Restrict)
  collectedByAdmin   Admin?                 @relation(fields: [collectedByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([storeCode, idempotencyKey])
  @@index([storeCode, orderId, createdAt])
  @@index([storeCode, collectedByAdminId])
  @@map("order_transaction")
}

model OrderStatusHistory {
  id           String         @id @default(uuid()) @db.Uuid
  storeCode    String         @map("store_code") @db.VarChar(50)
  orderId      String         @map("order_id") @db.Uuid
  fromStatus   OrderStatus?   @map("from_status")
  toStatus     OrderStatus    @map("to_status")
  actorType    OrderActorType @map("actor_type")
  // Separate actor keys allow real, store-scoped foreign keys for both roles.
  actorUserId  String?        @map("actor_user_id") @db.Uuid
  actorAdminId String?        @map("actor_admin_id") @db.Uuid
  reason       String?        @db.Text
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  order        Order          @relation(fields: [storeCode, orderId], references: [storeCode, id], onDelete: Restrict, onUpdate: Restrict)
  actorUser    User?          @relation(fields: [storeCode, actorUserId], references: [storeCode, id], onDelete: Restrict, onUpdate: Restrict)
  actorAdmin   Admin?         @relation(fields: [actorAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([storeCode, orderId, createdAt])
  @@index([storeCode, actorUserId])
  @@index([storeCode, actorAdminId])
  @@map("order_status_history")
}

model OrderOtp {
  id                String          @id @default(uuid()) @db.Uuid
  storeCode         String          @map("store_code") @db.VarChar(50)
  orderId           String          @map("order_id") @db.Uuid
  purpose           OrderOtpPurpose
  otpHash           String          @map("otp_hash") @db.Text
  recipientEmail    String          @map("recipient_email") @db.VarChar(255)
  status            OrderOtpStatus  @default(active)
  attemptCount      Int             @default(0) @map("attempt_count")
  maxAttempts       Int             @default(5) @map("max_attempts")
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz(6)
  lastSentAt        DateTime?       @map("last_sent_at") @db.Timestamptz(6)
  sendCount         Int             @default(0) @map("send_count")
  verifiedAt        DateTime?       @map("verified_at") @db.Timestamptz(6)
  verifiedByAdminId String?         @map("verified_by_admin_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  order             Order           @relation(fields: [storeCode, orderId], references: [storeCode, id], onDelete: Restrict, onUpdate: Restrict)
  verifiedByAdmin   Admin?          @relation(fields: [verifiedByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Partial unique index and CHECK constraints are maintained in SQL migration.
  @@index([storeCode, orderId, purpose, status])
  @@index([storeCode, status, expiresAt])
  @@index([storeCode, verifiedByAdminId])
  @@map("order_otps")
}

model User {
  orders       Order[]
  orderEvents  OrderStatusHistory[]
  addresses    UserAddress[]
  id           String   @id @default(uuid()) @db.Uuid
  storeCode    String   @map("store_code") @db.VarChar(50)
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  phoneNumber  String   @map("phone_number") @db.VarChar(20)
  email        String   @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([storeCode, email])
  @@unique([storeCode, id])
  @@map("users")
}

model UserAddress {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  storeCode            String   @map("store_code") @db.VarChar(50)
  shippingName         String   @map("shipping_name") @db.VarChar(100)
  shippingPhone        String   @map("shipping_phone") @db.VarChar(25)
  flatHouseNo          String   @map("flat_house_no") @db.VarChar(150)
  areaStreet           String   @map("area_street") @db.VarChar(200)
  landmark             String?  @db.VarChar(150)
  city                 String   @db.VarChar(100)
  state                String   @db.VarChar(100)
  country              String   @default("US") @db.VarChar(2)
  pincode              String   @db.VarChar(25)
  addressType          String   @default("Home") @map("address_type") @db.VarChar(20)
  deliveryInstructions String?  @map("delivery_instructions") @db.Text
  isDefault            Boolean  @default(false) @map("is_default")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Partial unique index for defaults is maintained in the SQL migration.
  @@index([userId, storeCode])
  @@map("user_addresses")
}

model Admin {
  role         String   @default("admin") @db.VarChar(20)
  orderTransactions OrderTransaction[]
  orderOtps         OrderOtp[]
  orderEvents       OrderStatusHistory[]
  id           String   @id @default(uuid()) @db.Uuid
  storeCode    String   @map("store_code") @db.VarChar(50)
  email        String   @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([storeCode, email])
  @@unique([storeCode, id])
  @@map("admin")
}

model Store {
  storeid            BigInt    @id @default(autoincrement())
  storename          String?   @db.VarChar(50)
  store_code         String?   @default("") @db.VarChar(50)
  storetime          String?   @db.VarChar(200)
  company_code       String?   @db.VarChar(50)
  storeaddress1      String?   @db.VarChar(200)
  storeaddress2      String?   @db.VarChar(200)
  storecity          String?   @db.VarChar(30)
  storestate         String?   @db.VarChar(20)
  storezipcode       String?   @db.VarChar(10)
  storephonenumber   String?   @db.VarChar(15)
  storefaxnumber     String?   @db.VarChar(15)
  storeaccountnumber String?   @db.VarChar(30)
  storeroutingnumber String?   @db.VarChar(30)
  is_active          Boolean   @default(true)
  created_by         Int
  created_on         DateTime  @default(now()) @db.Timestamp(6)
  updated_by         Int?
  updated_on         DateTime? @db.Timestamp(6)
  is_delete          Boolean?  @default(false)

  @@index([store_code], map: "tbl_store_store_code_idx")
  @@map("tbl_store")
}

model WebsiteBranding {
  id              String   @id @default(uuid()) @db.Uuid
  storeCode       String   @unique @map("store_code") @db.VarChar(50)
  logoWidth       Int      @default(56) @map("logo_width")
  navAlignment    String   @default("left") @map("nav_alignment") @db.VarChar(10)
  logoUrl         String?  @map("logo_url") @db.Text
  primaryColor    String   @default("#7A0E0E") @map("primary_color") @db.VarChar(7)
  headerColor     String   @default("#FFFFFF") @map("header_color") @db.VarChar(7)
  footerColor     String   @default("#7A0E0E") @map("footer_color") @db.VarChar(7)
  footerTextColor String   @default("#FFFFFF") @map("footer_text_color") @db.VarChar(7)
  accentColor     String   @default("#D0021B") @map("accent_color") @db.VarChar(7)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid

  @@map("tbl_website_branding")
}

model HeroBanner {
  id               String   @id @default(uuid()) @db.Uuid
  storeCode        String   @map("store_code") @db.VarChar(50)
  externalBannerId String?  @map("external_banner_id") @db.VarChar(100)
  imageUrl         String   @map("image_url") @db.Text
  eyebrow          String?  @db.VarChar(255)
  subtitle         String?  @db.Text
  heading          String?  @db.Text
  textColor        String   @default("#FFFFFF") @map("text_color") @db.VarChar(7)
  alignment        String   @default("left") @db.VarChar(10)
  overlayOpacity   Int      @default(40) @map("overlay_opacity")
  status           Int      @default(1)
  source           String   @default("ADMIN") @db.VarChar(20)
  syncBatchId      String?  @map("sync_batch_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?  @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid

  @@index([storeCode, status])
  @@map("tbl_hero_banner")
}

model WebsiteCategory {
  id                 String   @id @default(uuid()) @db.Uuid
  storeCode          String   @map("store_code") @db.VarChar(50)
  externalCategoryId String?  @map("external_category_id") @db.VarChar(100)
  categoryName       String   @map("category_name") @db.VarChar(150)
  imageUrl           String?  @map("image_url") @db.Text
  description        String?  @db.Text
  displayOrder       Int      @default(0) @map("display_order")
  isVisible          Boolean  @default(true) @map("is_visible")
  status             Int      @default(1)
  source             String   @default("ADMIN") @db.VarChar(20)
  syncBatchId        String?  @map("sync_batch_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?  @map("created_by") @db.Uuid
  updatedBy          String?  @map("updated_by") @db.Uuid

  @@index([storeCode, status, displayOrder])
  @@map("tbl_website_category")
}

model PosSyncLog {
  id               String   @id @default(uuid()) @db.Uuid
  storeCode        String   @map("store_code") @db.VarChar(50)
  syncType         String   @map("sync_type") @db.VarChar(30)
  requestId        String?  @map("request_id") @db.VarChar(100)
  syncBatchId      String   @map("sync_batch_id") @db.Uuid
  receivedCount    Int      @map("received_count")
  insertedCount    Int      @map("inserted_count")
  deactivatedCount Int      @map("deactivated_count")
  syncStatus       String   @map("sync_status") @db.VarChar(20)
  errorMessage     String?  @map("error_message") @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([storeCode, syncType, requestId])
  @@index([storeCode, syncType, createdAt])
  @@map("tbl_pos_sync_log")
}

model PosApiCredential {
  menuCreateVisibility Json @default("{}") @map("menu_create_visibility") @db.JsonB
  id        String   @id @default(uuid()) @db.Uuid
  storeCode String   @unique @map("store_code") @db.VarChar(50)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("tbl_pos_api_credential")
}

// Menu catalog: store codes are tenant keys, never Store foreign keys.
model MenuSyncLog {
  storeCode        String    @map("store_code") @db.VarChar(50)
  id               String    @id @default(uuid()) @db.Uuid
  requestId        String    @map("request_id") @db.VarChar(100)
  schemaVersion    String    @map("schema_version") @db.VarChar(20)
  syncType         String    @map("sync_type") @db.VarChar(20)
  catalogVersion   BigInt?   @map("catalog_version")
  status           String    @default("pending") @db.VarChar(20)
  recordsReceived  Int       @default(0) @map("records_received")
  recordsProcessed Int       @default(0) @map("records_processed")
  errorMessage     String?   @map("error_message") @db.Text
  receivedAt       DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([storeCode, id])
  @@unique([storeCode, requestId])
  @@index([storeCode, status, receivedAt])
  @@map("menu_sync_logs")
}

model MenuCategory {
  archivedAt         DateTime?          @map("archived_at") @db.Timestamptz(6)
  configuration      Json?              @db.JsonB
  storeCode          String             @map("store_code") @db.VarChar(50)
  id                 String             @id @default(uuid()) @db.Uuid
  externalCategoryId String?            @map("external_category_id") @db.VarChar(100)
  categoryName       String             @map("category_name") @db.VarChar(150)
  description        String?            @db.Text
  imageUrl           String?            @map("image_url") @db.Text
  displayOrder       Int                @default(0) @map("display_order")
  isVisible          Boolean            @default(true) @map("is_visible")
  isActive           Boolean            @default(true) @map("is_active")
  sourceType         String             @default("manual") @map("source_type") @db.VarChar(20)
  syncEnabled        Boolean            @default(false) @map("sync_enabled")
  lastSyncedAt       DateTime?          @map("last_synced_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  itemLinks          MenuItemCategory[] @relation("MenuItemCategory_category")

  @@unique([storeCode, id])
  @@unique([storeCode, externalCategoryId])
  @@index([storeCode, isVisible, displayOrder])
  @@map("menu_categories")
}

model MenuItem {
  orderItems                   OrderItem[]
  archivedAt                   DateTime?               @map("archived_at") @db.Timestamptz(6)
  configuration                Json?                   @db.JsonB
  storeCode                    String                  @map("store_code") @db.VarChar(50)
  id                           String                  @id @default(uuid()) @db.Uuid
  externalItemId               String?                 @map("external_item_id") @db.VarChar(100)
  sku                          String?                 @db.VarChar(100)
  itemName                     String                  @map("item_name") @db.VarChar(200)
  description                  String?                 @db.Text
  imageUrl                     String?                 @map("image_url") @db.Text
  itemType                     String                  @default("regular") @map("item_type") @db.VarChar(30)
  foodType                     String?                 @map("food_type") @db.VarChar(30)
  basePrice                    Decimal                 @default(0) @map("base_price") @db.Decimal(12, 2)
  comparePrice                 Decimal?                @map("compare_price") @db.Decimal(12, 2)
  taxRuleId                    String?                 @map("tax_rule_id") @db.Uuid
  isFeatured                   Boolean                 @default(false) @map("is_featured")
  isVisible                    Boolean                 @default(true) @map("is_visible")
  isAvailable                  Boolean                 @default(true) @map("is_available")
  displayOrder                 Int                     @default(0) @map("display_order")
  preparationTime              Int?                    @map("preparation_time")
  allowSpecialInstructions     Boolean                 @default(true) @map("allow_special_instructions")
  specialInstructionsMaxLength Int                     @default(250) @map("special_instructions_max_length")
  minimumQuantity              Int                     @default(1) @map("minimum_quantity")
  maximumQuantity              Int?                    @map("maximum_quantity")
  nutritionInfo                Json?                   @map("nutrition_info") @db.JsonB
  allergens                    Json?                   @db.JsonB
  tags                         Json?                   @db.JsonB
  metadata                     Json?                   @db.JsonB
  sourceType                   String                  @default("manual") @map("source_type") @db.VarChar(20)
  syncEnabled                  Boolean                 @default(false) @map("sync_enabled")
  lastSyncedAt                 DateTime?               @map("last_synced_at") @db.Timestamptz(6)
  createdBy                    String?                 @map("created_by") @db.Uuid
  updatedBy                    String?                 @map("updated_by") @db.Uuid
  createdAt                    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
