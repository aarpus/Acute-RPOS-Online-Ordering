{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rpos-online-ordering",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "placement": {
    "region": "aws:us-east-2"
  },
  "images": {
    "binding": "IMAGES"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a9845ceea3d54b28a3dc3a9b7138feb3"
    }
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "cache": {
    "enabled": false
  }
}
