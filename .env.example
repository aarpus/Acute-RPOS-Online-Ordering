COMPANY_CODE=your-company-code
# Enable only after the response-store Worker and its CACHE_BODIES bucket exist.
RPOS_RESPONSE_STORE_ENABLED=false
ADMIN_USER_ID=123
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
EMAIL_VERIFICATION_SECRET=replace-with-a-random-secret-at-least-32-characters
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=Spice Table <your-zoho-mailbox@example.com>

# Branding R2 is optional. To enable it, add the actual existing bucket as
# BRANDING_IMAGES under r2_buckets in wrangler.jsonc; an env var alone does not bind it.

# Server-only tenant scope for customer addresses.
STORE_CODE=your-store-code
