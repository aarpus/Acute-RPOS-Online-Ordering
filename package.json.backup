{
	"name": "online-ordering-web",
	"version": "0.1.0",
	"private": true,
	"packageManager": "npm",
	"dependencies": {
		"@prisma/adapter-pg": "6.19.3",
		"@prisma/client": "6.19.3",
		"@types/nodemailer": "^8.0.2",
		"@vinext/cloudflare": "latest",
		"nodemailer": "^10.2.1",
		"pg": "8.23.1",
		"react": "latest",
		"react-dom": "latest",
		"react-server-dom-webpack": "latest",
		"vinext": "latest",
		"worker-mailer": "^1.3.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "beta",
		"@tailwindcss/postcss": "latest",
		"@types/node": "latest",
		"@types/pg": "8.23.1",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@vitejs/plugin-react": "latest",
		"@vitejs/plugin-rsc": "latest",
		"cf": "^1.0.0-beta.21",
		"prisma": "6.19.3",
		"tailwindcss": "latest",
		"typescript": "latest",
		"vite": "8.3.0",
		"wrangler": "^4.160.1"
	},
	"type": "module",
	"scripts": {
		"predev": "prisma generate",
		"prebuild": "prisma generate",
		"dev": "vinext dev",
		"build": "vinext build",
		"start": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js preview",
		"deploy": "vinext-cloudflare deploy",
		"preview": "npm run build && npm run start --",
		"cf-typegen": "cf workers types",
		"db:generate": "prisma generate",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:seed:admin": "node --experimental-strip-types --env-file=.env scripts/seed-admin.mjs",
		"db:admin:role": "node --env-file=.env scripts/set-admin-role.mjs",
		"test:menu:permissions": "node scripts/test-menu-create-policy.mjs",
		"test:menu:visibility": "node scripts/test-menu-visibility.mjs",
		"test:branding": "node --env-file=.env scripts/test-branding.mjs",
		"test:pos:categories": "node scripts/test-pos-menu-categories.mjs",
		"test:pos:tax-rules": "node --env-file=.env scripts/test-pos-tax-rules.mjs",
		"test:pos:modifier-groups": "node --env-file=.env scripts/test-pos-modifier-groups.mjs",
		"test:pos:items": "node --env-file=.env scripts/test-pos-items.mjs",
		"test:pos:combo-items": "node --env-file=.env scripts/test-pos-items.mjs --combo",
		"test:pos:variants": "node --env-file=.env scripts/test-pos-variants.mjs",
		"test:pos:modifier-options": "node --env-file=.env scripts/test-pos-modifier-options.mjs",
		"test:pos:offers": "node --env-file=.env scripts/test-pos-offers.mjs",
		"test:pos:images": "node --env-file=.env scripts/test-pos-images.mjs",
		"test:pos:combo-options": "node --env-file=.env scripts/test-pos-combo-options.mjs",
		"test:pos:combo-groups": "node --env-file=.env scripts/test-pos-combo-groups.mjs",
		"test:pos:modifier-links": "node --env-file=.env scripts/test-pos-modifier-links.mjs",
		"test:branding:http": "node --env-file=.env scripts/test-branding-http.mjs",
		"test:storefront": "node scripts/test-storefront.mjs",
		"test:addresses": "node scripts/test-addresses.mjs",
		"test:addresses:http": "node --env-file=.env scripts/test-addresses-http.mjs",
		"test:menu": "node scripts/test-menu-crud.mjs",
		"test:menu:design": "node scripts/test-menu-design.mjs",
		"test:menu:schema": "node scripts/test-menu-schema.mjs",
		"test:orders:schema": "node scripts/test-order-schema.mjs",
		"test:orders": "node scripts/test-order-flow.mjs"
	}
}
